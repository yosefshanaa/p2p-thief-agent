# Secret placeholders - copy to .env and fill in (NEVER commit .env).
# .env is git-ignored and the repo-sync script copies tracked files only,
# so a key placed here cannot reach either submission repo.
# Only the provider you select in config/<role>/game.toml is used.
OPENAI_API_KEY=sk-REPLACE_ME              # [trash_talk] provider = "openai"
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME       # [trash_talk] provider = "claude_api"
OLLAMA_HOST=http://localhost:11434        # informational; ollama uses [llm] base_url
