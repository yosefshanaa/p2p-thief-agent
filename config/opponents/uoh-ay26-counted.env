# uoh-ay26 (Aisha Abu Dahesh + Yousef Asadi) - THE COUNTED MATCH.
#
# A SEPARATE FILE from uoh-ay26.env on purpose. The friendly's contract points
# email away from the lecturer; this one does not. The book allows exactly ONE
# counted encounter per pair and it is sealed the moment both reports are filed,
# so mixing the two files up is the mistake that cannot be undone.
#
#   scripts/play.sh uoh-ay26-counted --counted --prior-counted 5 \
#       --role police --games 6
#
# play.sh will refuse a dirty tree (exit 5) and demand the word "counted" typed
# in full before it runs.
#
# -- wire contract: unchanged, proven over TWO full six-sub-game friendlies ----
# F003 and F004 both completed 6/6 with `Verified OK` on both sides, and F004
# confirmed mutual series consensus (9c26ba0a...) after they patched their
# auxiliary-record verifier. Nothing below is speculative.
P2P_DIALECT=reference
P2P_ALTERNATE_ROLES=true
P2P_OPPONENT_COP_URL=https://cop.uohay26game.com/mcp
P2P_OPPONENT_THIEF_URL=https://theif.uohay26game.com/mcp
P2P_HANDSHAKE_PER_SUB_GAME=true
P2P_SERIES_CONSENSUS=true
# MEASURED 2026-08-19, and it reverses the guess above. Claiming on every
# police turn hands the thief our exact cell every turn: `turn_engine._answer_claim`
# collapses the answering side's belief to a delta on the claimed cell, which is
# the claimant's own position. Against `learn.opponents.Evader` over 100 hold-out
# seeds, police capture rate:
#
#     book_v1      always_claim=false 35%   ->   always_claim=true  0%
#     subtractive  always_claim=false 21%   ->   always_claim=true 23%
#
# Under book_v1 the thief otherwise has only a one-turn-old fix, so the claim is
# the whole leak - and gal-roy1, played on book_v1 with this set, converted 0 of
# 3. Under subtractive it costs nothing because the thief can invert our served
# field anyway. The forfeited-capture risk this was hedging against is closed by
# v6: `police_brain.should_claim` already claims whenever the tracker puts the
# thief on the cell we just took, which is exact under subtractive and a spread
# under book_v1. Every match we played WITHOUT this converted 3 of 3.
P2P_ALWAYS_CLAIM=false
P2P_CLAIM_ENCLOSURE=true
P2P_SIGNED_NUM_GAMES=6
P2P_MY_PORT=8801

# -- scent: locked, and paired with its own doctrine --------------------------
P2P_SCENT_MODEL=subtractive_chebyshev_v1
P2P_DOCTRINE=config/doctrine-subtractive.json

# -- EMAIL: DELIBERATELY UNSET, so the report goes to the LECTURER ------------
# With no override here the committed role config applies:
#   mode = "send", recipient = rmisegal+uoh26finalgame@gmail.com
# That is correct and REQUIRED for a counted match, and it is exactly why this
# file is separate from the friendly's. Do not add P2P_EMAIL_* lines here.

# -- PENDING: the one value that must be agreed before this can run -----------
# `game_id` is the FIRST KEY of the series-consensus preimage, so both sides
# must use the identical string or mutual agreement fails at the end of an
# otherwise clean six-game series - which is precisely what happened in F003.
#
# CONFIRMED IN WRITING 2026-08-19. They proposed it and named it "the exact
# official counted label"; we adopt their string verbatim rather than derive our
# own (`ahk-yosi-vs-uoh-ay26`), for the same reason we adopted F003/F004: two
# sides computing different digests fail mutual agreement at the end of an
# otherwise clean series, which is exactly what F003 demonstrated.
#
# C001, not F00x. F001-F004 all name settled friendlies and must never be reused
# for the counted encounter.
P2P_GAME_ID=AHK-YOSI-vs-uoh-ay26-C001
