# Negotiated contract for the 2026-08-12 friendly (team name not yet given - rename
# this file once their handshake reports their group_id).
#
#   fish:  for l in (grep -v '^#' config/opponents/friendly-0812.env); set -x (string split -m1 = $l); end
#   bash:  set -a; . config/opponents/friendly-0812.env; set +a
#
# Their brief, verbatim: P2P_DIALECT=reference, P2P_ALTERNATE_ROLES=1,
# P2P_HANDSHAKE_PER_SUB_GAME=1, P2P_CLAIM_ENCLOSURE=0, roles alternate every
# sub-game, thief moves first, handshake before every sub-game, timeout 180 s,
# their prior counted-game count 0, constitution sha256
# 3835f6a137620d8d98ab3925b2d1ed397d2d20d23bb9ba857bcd104284aac443 - which is
# ours byte-for-byte, so no term overrides are needed.

# -- wire contract (their brief) ---------------------------------------------
P2P_DIALECT=reference
P2P_ALTERNATE_ROLES=true
P2P_HANDSHAKE_PER_SUB_GAME=true

# They asked for CLAIM_ENCLOSURE=0, so an enclosed thief is theirs to announce
# (or the rule is off on their side). Our cop must not also claim it - two
# mechanisms reporting one event desynchronises the series. Opposite of our
# book-backed default, same as every reference-family opponent so far.
P2P_CLAIM_ENCLOSURE=false

# -- scent physics: UNCONFIRMED, running our published default ---------------
# They sent no scent expression, and the constitution hash does not pin one:
# tau0/rho/5x5 are shared by both models, but book_v1 rounds to 4 dp, floors
# dust at 1e-3 and serves the field BEFORE the step's own emission (freshest
# cell 0.81), while registered_v3 does none of that and serves AFTER (0.9).
# Their cross-compatibility tests ran against our public repos, which play
# book_v1, so that is what we run - with the doctrine tuned for it. If they
# answer 0.9, swap BOTH lines together (a doctrine belongs to a physics):
#   P2P_SCENT_MODEL=registered_v3
#   P2P_DOCTRINE=config/doctrine-registered_v3.json
P2P_SCENT_MODEL=book_v1
# Thief keys re-searched after the 2026-08-12 friendly, where our thief lost 6 of
# 6: enclosed 4x, barrier-captured 2x, every time in a right-edge pocket it had
# walked into and then STAYed in. CEM pushed corner_penalty 0.24 -> 1.31 and
# stay_penalty 0.05 -> 1.23; hold-out survival 81% -> 89% on unseen seeds.
# The POLICE keys are byte-identical to config/doctrine.json - `learn tune
# --role thief` writes a whole file whose untouched keys come from the shipped
# DEFAULTS, so taking its output wholesale would have reverted the tuned police
# vector that went 6 of 6. Only the 11 thief keys are layered on.
P2P_DOCTRINE=config/doctrine-orcai-mj.json

# -- FRIENDLY: never mail the lecturer ---------------------------------------
# Both role configs ship [email] mode = "send". A friendly report filed against
# an opponent risks being read as THE counted encounter, and the book allows
# exactly one per pair, sealed once filed. So a friendly must be INCAPABLE of
# sending, not merely unlikely to. Remove this line - and only this line - for
# the counted match.
# RESTORED after the 2026-08-13 counted attempt was aborted: their thief never
# opened sub-game 1, we killed our peer before the reporting step, and nothing
# was filed - so the one counted encounter with them is still unplayed. Remove
# this line again only at the moment of a real counted launch; the role configs
# carry mode="send", and a missing report forfeits our points (book 9.2.1).
# 2026-08-13: a first counted report for orcai-mj was filed (gmail
# 19ffc9b88015b70c, 50-50, series_tie) from a series that died at sub-game 5 when
# their peer went 502. Operator decision to rerun and file the complete series as
# the corrected result, with the circumstances disclosed to the lecturer.
# Restored after the counted encounter was played and filed on 2026-08-13
# (gmail 19ffcbcac8890b74, 75-75 series tie). One counted game per opponent, so
# nothing against orcai-mj may mail again: this line must stay until a DIFFERENT
# opponent's contract is written, and it is removed only at the moment of that
# match's launch.
P2P_EMAIL_MODE=draft

# -- constitution: PER-OPPONENT CONFIG DIR, not the committed one ------------
# 2026-08-13 they renamed agreed_between to ["ahk-yosi", "orcai-mj"], new hash
# fef1fe3a229b0c7daece9f1e3ebe7a097a7207e6ac0628b6c67050595a6101be (reproduced
# exactly on our side, so their file differs from ours in nothing else).
# agreed_between names ONE opponent, so it cannot live in config/<role>/game.json:
# that file is our default for every other team, and changing it would fail their
# handshakes. There is no NEGOTIABLE_TERM_VARS entry for a top-level key, so the
# agreed file lives in its own tree and BOTH peers must be launched with:
#
#   --config-dir config/opponents/orcai-mj/police     (police, port 8802)
#   --config-dir config/opponents/orcai-mj/thief      (thief,  port 8801)
#
# Committed constitution stays 3835f6a1...aac443, the placeholder "opponent-team".

# -- match day ---------------------------------------------------------------
# Two endpoints, so two pairings; each peer takes the opposite-role endpoint:
#   our thief  (8801) -> their cop   https://texts-headlines-markers-genome.trycloudflare.com/mcp
#   our police (8802) -> their thief https://studio-arbitrary-integer-complex.trycloudflare.com/mcp
# P2P_OPPONENT_URL is set per process at launch, not here.
