# MaRs-777 (Mohamed Awad + Rawey Sleiman) - COUNTED series. Identical contract
# to the friendly, and separate ONLY because of where the report goes. Read
# config/opponents/MaRs-777.env for why every line below is what it is; nothing
# is re-argued here.
#
#   scripts/play.fish MaRs-777-counted <their-/mcp-url> \
#       --role thief --counted --prior-counted 8
#
# THE TWO FLAGS ARE NOT OPTIONAL AND NOT IN THIS FILE, because neither is an
# environment variable:
#
#   --counted           enforces the binding six sub-games, the typed
#                       confirmation and the clean-tree refusal.
#   --prior-counted N   our truthful rule-37 count. Derive it from matches/,
#                       never from memory: the count at the 2026-08-24 series
#                       was 7, so the next one is 8.
#
# Written after the 2026-08-24 series was played against the FRIENDLY file by
# mistake, which mailed a counted result to our own inbox instead of the league
# address. The friendly file says so in its own reporting section; it was read
# past. This file exists so that cannot happen twice.

# verified against their published vectors. See docs/REPLY_MaRs-777*.md.
#
#   set -a; source config/opponents/MaRs-777.env; set +a
#
# NOT counted. P2P_EMAIL_MODE stays `draft`.
#
# ROLE IS A LAUNCH FLAG, NOT AN ENV VAR: start with `--role thief`.
# Their shipped contract pins MaRs-777 to police in sub-game 1 and their code
# refuses an operator override, so we open thief and take police on 2/4/6.
# Over a complete six windows this is score-neutral - alternation gives each
# side three of each - and it only costs a window if the series truncates odd.

# -- wire contract ------------------------------------------------------------
P2P_DIALECT=reference
P2P_ALTERNATE_ROLES=true
P2P_HANDSHAKE_PER_SUB_GAME=true

# -- physics ------------------------------------------------------------------
# Their document, which is byte-identical to the one yanell11 registered:
#   sha256(docs/locks/scent_multiplicative_book_v1.json)
#     = 934c220d5bf62acaa3297c6c9d723ea954c220260b02292ca17f6d5daef9f4d9
# Their printed 5x5 served field reproduces cell-for-cell through this model,
# and their 0.9 -> 0.81 (multiplicative, not subtractive) reproduces too.
P2P_SCENT_MODEL=multiplicative_book_v1
P2P_DOCTRINE=config/doctrine-registered_v3.json

# -- negotiated terms ---------------------------------------------------------
# The one key that separated our 14 terms from theirs. With it set the two
# canonical term strings are byte-identical and the derived ids agree:
#   game_id  = MaRs-777-vs-ahk-yosi
#   game_uid = 5ed16f3b-4e6b-4e9d-65bf-8f5abab699f2   (reproduced on both sides)
P2P_MAP_AREA=Haifa
# DELIBERATELY UNSET: P2P_GAME_ID. Their game_id has no label slot at all, so a
# label on our side alone would move the uid out from under both of us.

# -- claims -------------------------------------------------------------------
P2P_ALWAYS_CLAIM=false
# OFF, and this one is not symmetric with other opponents. Their enclosure
# emitter is thief-side (GAME-005, self-reporting); ours is pursuer-side. Exactly
# one side may report it and it is theirs. Our OWN thief still settles CAPTURE on
# an enclosed cell - turn_engine.py:61 and :203 are unconditional and do not read
# this flag - so clearing it silences only our police-side claim.
P2P_CLAIM_ENCLOSURE=false

# -- patience -----------------------------------------------------------------
# Theirs is 1800s on every path we touch (their rev-3 correction; the 30/60 pair
# they first quoted belongs to an internal fixed-role path we never meet).
P2P_HANDSHAKE_BUDGET=1000
P2P_REHANDSHAKE_BUDGET=1000
P2P_WINDOW_REOFFERS=0

# -- consensus ----------------------------------------------------------------
P2P_SERIES_CONSENSUS=true
# THEIR serialization: {game_id, aggregate, sub_games}, json.dumps DEFAULTS, no
# game_uid. It is our own mutual_signature projection carried on the consensus
# tool. Mismatched, their run stops before a result exists - settle() returns
# None, no result_sha256, no artifact, and rule 35 scores 0 for both teams.
P2P_CONSENSUS_PROJECTION=signature
# NOTE: consensus_wait_sec (600) and consensus_retry_sec (5) have no env
# override - they are TOML only, in config/police/game.toml [interop].

# -- result agreement (their B4 extension) ------------------------------------
# Sends a Step-0 declaration at the handshake and exchanges `result_agreement`
# on `receive_control` after the series. BOTH halves matter and for different
# reasons:
#   Step-0 is load-bearing for the SERIES, not just the report - their backend
#   publishes a per-window contribution that needs a merged declaration, and
#   without one their police crashed after window 1 of the 2026-08-24 friendly.
#   The result agreement is what lets them file at all: no result_sha256, no
#   mutual_agreement, official set never reaches 14, rule 35 = 0 for BOTH teams.
# Verified against their published vectors in both directions:
#   4a8297dc… (their 17:36 core)  and  3134773c… (their template, our repo URLs)
P2P_RESULT_AGREEMENT=true

# -- doors --------------------------------------------------------------------
# ONE URL, both roles - a gateway in front of two private role backends. Both
# door vars are set to it anyway: that is what arms the split-peer guard in
# `_join_at_their_index` (b6b8605), and the retarget then resolves to the same
# address and is a no-op. Their negotiate answers a bare {"ok": true} with no
# sub_game_number, so there is nothing at their door to misread - but we would
# rather be protected by construction than by their good behaviour.
P2P_OPPONENT_COP_URL=https://exposure-nimble-wackiness.ngrok-free.dev/mcp
P2P_OPPONENT_THIEF_URL=https://exposure-nimble-wackiness.ngrok-free.dev/mcp
# We run ONE process, roles alternating internally, so both our published doors
# are the same URL. Port pinned because the tunnel forwards to 8802.
P2P_MY_PORT=8802
P2P_PUBLIC_COP_URL=https://zealous-sliver-gleeful.ngrok-free.dev/mcp
P2P_PUBLIC_THIEF_URL=https://zealous-sliver-gleeful.ngrok-free.dev/mcp

# -- reporting ----------------------------------------------------------------
# A COUNTED result goes to the LEAGUE ADDRESS, from each team separately.
# Not the opponent, and not our own inbox - that is the friendly's recipient
# and mailing a counted result there files it nowhere.
P2P_EMAIL_MODE=send
P2P_EMAIL_RECIPIENT=rmisegal+uoh26finalgame@gmail.com
P2P_TRASH_TALK_PROVIDER=template

# Their slug. Both shared ids derive from the terms and the two slugs, so this
# one value lets Step-0 name the agreed game before any handshake has happened.
P2P_OPPONENT_GROUP_ID=MaRs-777

# Agreed start constant, compared by exact equality in their Step-0 check.
# Not a deadline: the instant has passed and that is fine - both declarations
# must simply carry the same signed value.
P2P_GAME_START=2026-08-24T19:15:00Z
