# Team s82kma9e - THE COUNTED MATCH. Separate file from s82kma9e.env on purpose:
# the friendly's contract points email away from the lecturer, and the one
# mistake that cannot be undone is mixing those two up.
#
#   *** NOT READY TO LAUNCH - see PENDING at the bottom. ***
#
# The book allows exactly ONE counted encounter per pair, sealed the moment both
# reports are filed. play.sh demands the word "counted" typed in full before it
# will run this.
#
#   scripts/play.sh s82kma9e-counted <their-url> --counted --prior-counted 3 \
#       --role police --config-dir <counted config dir, once agreed>

# -- wire contract: unchanged from the friendly, all six sub-games proven ------
P2P_DIALECT=reference
P2P_ALTERNATE_ROLES=true
P2P_HANDSHAKE_PER_SUB_GAME=true
P2P_CLAIM_ENCLOSURE=false
P2P_ALWAYS_CLAIM=false
P2P_SERIES_CONSENSUS=false

# -- scent: LOCKED this time, not omitted -------------------------------------
# We now implement their physics (domain/scent.py, golden-tested against both
# fields they published). The friendly ran with no lock because we could not
# reproduce it; a counted series should not.
P2P_SCENT_MODEL=subtractive_chebyshev_v1
# Physics and doctrine are one decision in two variables. A subtractive field is
# a SHORT memory - the outer ring is gone in three steps - so trail-age reasoning
# tuned on multiplicative traces reads it wrong; Yosef measured that costing
# roughly two thirds of our captures against uoh-sqak. The counted match on
# 2026-08-17 was played before this line existed, on the book-tuned default.
P2P_DOCTRINE=config/doctrine-subtractive.json

# -- game_id ------------------------------------------------------------------
# Deliberately NOT set. With the real slugs our derivation produces
# `ahk-yosi-vs-s82kma9e`, which is what both sides independently derived. Do not
# carry the sparring label over - it names a settled series.

# -- EMAIL: goes to the LECTURER ----------------------------------------------
# No override here, so the committed role config applies:
#   mode = "send", recipient = rmisegal+uoh26finalgame@gmail.com
# That is correct and required for a counted match - and it is exactly why this
# file is separate from the friendly's. Ahmad confirmed 2026-08-17.

