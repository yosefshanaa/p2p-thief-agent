# yanell11 (Nell Khoury, Yanal Serhan) - FRIENDLY, 2026-08-23 19:10 IDT.
# Settled over four rounds of contract exchange; every value below is agreed and
# most are verified against their published vectors. See docs/REPLY_yanell11_r4.md.
#
#   set -a; source config/opponents/yanell11.env; set +a
#
# NOT counted. P2P_EMAIL_MODE stays `draft` - the friendly report is reviewed by
# hand before it goes anywhere.

# -- wire contract ------------------------------------------------------------
P2P_DIALECT=reference
P2P_ALTERNATE_ROLES=true
P2P_HANDSHAKE_PER_SUB_GAME=true

# -- physics ------------------------------------------------------------------
# THEIR document, adopted 2026-08-23. Algebraically identical to our
# `registered_v3` - same kernel, rho, clamp and serve-after-update - but pinned
# in their graded conformance vectors, so the *document* had to be ours to hold:
#   sha256(docs/locks/scent_multiplicative_book_v1.json)
#     = 934c220d5bf62acaa3297c6c9d723ea954c220260b02292ca17f6d5daef9f4d9
# The lock is over the document and never over the behaviour.
P2P_SCENT_MODEL=multiplicative_book_v1
# Fitted to exactly this physics, so it carries over unchanged from registered_v3.
P2P_DOCTRINE=config/doctrine-registered_v3.json

# -- negotiated terms ---------------------------------------------------------
# The one key that separated our 14 terms from theirs. With it set, the two
# canonical term strings are byte-identical (test_yanell11_contract).
P2P_MAP_AREA=Haifa

# -- series identity ----------------------------------------------------------
# Replaces the derived game_id outright, and is folded into the game_uid:
#   game_uid = a0b99406-11d1-384c-823c-0315c9596bab
# The uid is the second key of the consensus document, so both sides must derive
# the same one or a clean 6/6 fails to confirm.
P2P_GAME_ID=ahk-yosi-vs-yanell11-friendly-1

# -- claims -------------------------------------------------------------------
# Threshold, both sides. Always-claim leaks the claimant's own cell: measured
# 35% -> 0% capture under book, and it cost us a counted series (0 of 3).
P2P_ALWAYS_CLAIM=false
# Their thief emits the rule-47 concession; exactly one side may report it.
P2P_CLAIM_ENCLOSURE=false

# -- patience -----------------------------------------------------------------
# Both sides raised to 1000s. Whichever peer runs out of patience first is
# indistinguishable from a broken opponent, so the impatient side manufactures
# the failure. Covers our ~3-minute bind either way.
P2P_HANDSHAKE_BUDGET=1000
P2P_REHANDSHAKE_BUDGET=1000
# A failed window scores a technical-loss row and we advance - they do not re-offer.
P2P_WINDOW_REOFFERS=0

# -- consensus ----------------------------------------------------------------
P2P_SERIES_CONSENSUS=true
# NOTE: consensus_wait_sec has no env override - it is TOML only. The agreed
# 600s linger is set in config/police/game.toml [interop].

# -- doors --------------------------------------------------------------------
# They run the rule-1 split: two processes, two hosts. We dial their COP door on
# the windows where we are thief (2/4/6) and their THIEF door where we are cop
# (1/3/5); `opponent_url_for` picks by the role THEY hold.
P2P_OPPONENT_COP_URL=https://seconds-opponent-custom-bases.trycloudflare.com/mcp
P2P_OPPONENT_THIEF_URL=https://outcomes-underlying-isbn-emacs.trycloudflare.com/mcp
# We run ONE process, roles alternating internally, so both our published doors
# are the same URL. Port pinned because the tunnel forwards to 8802 and booting
# the thief config would otherwise bind 8801 and dead-end it.
P2P_MY_PORT=8802
P2P_PUBLIC_COP_URL=https://zealous-sliver-gleeful.ngrok-free.dev/mcp
P2P_PUBLIC_THIEF_URL=https://zealous-sliver-gleeful.ngrok-free.dev/mcp

# -- reporting ----------------------------------------------------------------
P2P_EMAIL_MODE=draft
P2P_EMAIL_RECIPIENT=yanalserhan3@gmail.com
# Agreed: zero-token banter is fine on both sides.
P2P_TRASH_TALK_PROVIDER=template
