# Negotiated contract vs. team `saedshki` (Moodle/package GRP00001).
# Source: their "READY - match setup with ahk-yosi" reply, received 2026-08-16.
# Members: Mohamed Shawki 214502080, Saed-Abdalgani 325812667.
# Repos: cop https://github.com/JCS1029/GRP00001-police-p2p
#        thief https://github.com/JCS1029/GRP00001-thief-p2p
#
#   scripts/play.sh saedshki https://their-tunnel.example/mcp --role thief --games 6
#
# Their constitution answer is "we accept your book defaults", and every value
# they list back matches config/*/game.json exactly - map_area "New York",
# pheromone_grid_size 5 ("smell 5"), tau0 0.9, rho 0.10, 7x7, (3,3)/(0,0),
# top-left index 0, 35 moves, 14 barriers, 20/5/5/10/2. So NO negotiable-term
# override is needed and our config_sha256 stays
# 3835f6a137620d8d98ab3925b2d1ed397d2d20d23bb9ba857bcd104284aac443.
# They lock the 14 keys directly rather than comparing that nested SHA.

# -- wire contract (their item 1) --------------------------------------------
# Reference 4-tool set: negotiate / receive_turn / submit_audit /
# receive_control, push-and-inbox. They explicitly will NOT use our native
# four-phase surface. Confirm with the probe before the warm-up:
#   PYTHONPATH=src .venv/bin/p2p-pursuit smoke https://their-url/mcp
P2P_DIALECT=reference

# Their item 2: odd sub-games natural role, even opposite. Sub-game 1 is
# ahk-yosi=thief, saedshki=police - so launch sub-game 1 with --role thief.
P2P_ALTERNATE_ROLES=true

# Their item 3.
P2P_HANDSHAKE_PER_SUB_GAME=true

# -- enclosure (their item 4) - CONFIRMED, DO NOT FLIP ----------------------
# Both sides agree the rule: only open orthogonal neighbours count as escapes,
# STAY does not save the thief. Ours is strategy/squeeze.py `exits()`.
#
# They answered our who-announces-it question explicitly with (a): "our thief
# self-reports when enclosed (win_claim type=capture) - leave your police
# enclosure claim OFF so one capture is not reported twice." Fourth
# reference-family peer in a row to announce it thief-side.
#
# So `false` is confirmed, not assumed. Our thief still self-reports
# unconditionally (peer/turn_engine.py:61); this flag only suppresses our
# POLICE claim (turn_engine.py:67). Setting it true would double-report one
# capture and void the series.
P2P_CLAIM_ENCLOSURE=false

# -- pheromone physics (their constitution paragraph) ------------------------
# "multiplicative 5x5 kernel, serve field BEFORE that step's emission, 4-digit
# round, tau_0=0.9 -> 0.81, kernel matches yours" - that is book_v1 verbatim.
P2P_SCENT_MODEL=book_v1
# Our own tuning, never a negotiated term.
P2P_DOCTRINE=config/doctrine.json

# -- reporting ---------------------------------------------------------------
# SAFED AGAIN. The counted match against saedshki was played and filed on
# 2026-08-16 (game_number 3, 85-45, archived under
# matches/saedshki-counted/), and there is only one counted game per opponent
# (book 9.2.1) - so nothing loading this file should ever mail the lecturer
# again. Re-arming it would require deleting the line below, which is
# deliberate rather than accidental.
P2P_EMAIL_MODE=draft

# -- series consensus (their item 7) - AGREED --------------------------------
# They hash {game_id, game_uid, sub_games[]} with per-sub-game roles, results
# and scores, and exchange consensus_sha - which is byte-for-byte the document
# report/consensus.py builds (consensus_document(), "no aggregate" per its own
# docstring). This is what rescued G012, where a reference peer's missing audit
# return path filed mutual_agreement:false despite both sides agreeing.
P2P_SERIES_CONSENSUS=true

# -- transport: SESSION mode, agreed with them 2026-08-16 --------------------
# Their FastMCP streamable-HTTP client opens an SSE session with `GET /mcp`.
# Our default stateless server has no GET stream and answers 405, so the first
# counted attempt handshook over POST, started sub-game 1, then both peers
# waited forever on a stream that could never open. Measured: 3x 405, then two
# minutes of silence with zero sub-games settled.
#
# Stateless is the right default for peers that have no MCP sessions - that is
# why it became the default - so this is set per opponent rather than globally.
P2P_STATELESS_HTTP=false

# -- not agreed, left at the derived default ---------------------------------
# No mutual game_id label was settled; the derived "<lo>-vs-<hi>" applies.
# They package as GRP00001 if they later want it named.
#P2P_GAME_ID=
