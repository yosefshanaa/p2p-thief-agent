# vibecode (Ron Marom + Amit Kuperminz) - FRIENDLY contract, from their pairing
# greeting 2026-08-18. Every value below is either quoted from that message or
# verified against our own code; the unverified ones are called out as such.
#
#   scripts/play.sh vibecode --role police --games 6
#
# THEY RUN TWO OS PROCESSES, ONE PER ROLE (Appendix E rule 1), on two *ports* of
# one static public IP:
#
#     cop    http://62.56.220.143:61224/mcp   (dial this when they hold cop)
#     thief  http://62.56.220.143:61223/mcp   (dial this when they hold thief)
#
# That is a split a `{role}` substitution cannot express - it builds path
# segments, and `:6122{role}` yields `:6122cop`, which is not a port. Hence the
# two P2P_OPPONENT_*_URL variables below and `opponent_url_for`'s door map,
# added for this contract. The door is re-selected at every alternation
# boundary by peer/series_protocol.retarget_link.
#
# NATURAL ROLE = POLICE, and it is forced. Their rule: "roles alternate by the
# sorted pair of group ids: the group sorting FIRST plays cop in sub-games
# 1/3/5". sorted(['ahk-yosi','vibecode'])[0] == 'ahk-yosi', so we cop the odd
# sub-games and they cop the even ones. Launching --role thief would put both
# peers on the same role in all six sub-games.
#
# SCENT MODEL IS THE HARD GATE and it is AGREED. They require
# subtractive_chebyshev_v1 and quoted its locked hash; ours computes the same
# value byte for byte:
#     81ebee59640e80eae8ca9ee5f86abd26e7edf5cdbb27d15925cb6ee45ca6ddf4
# Their refusal rule aborts the series on a declared-and-different hash, so this
# is the one line that must not be edited without re-deriving the digest.
#
# THE MODEL AND THE DOCTRINE ARE ONE DECISION IN TWO VARIABLES. Playing the kit
# physics on the book vector is silent - it does not error, our thief just
# survives 64.4% where the matching vector survives 98.3% (docs/STRATEGY.md
# 10.11). doctrine-subtractive.json was re-searched under this exact physics.
#
# Repos (public):
#   cop   https://github.com/AmitKuper/vibecode-cop
#   thief https://github.com/AmitKuper/vibecode-thief
# Their armed Step-0 commits: cop 39e757f6450a20431dd7dd764b2efed050bd4ec7
#                             thief 542eb9337ff1b9a4a6ffdf1e54c36d014fbe75ea
# Their report-from: agentsorch@gmail.com   Timezone: Israel (IST)
# Counted series they have played: 6 (anrbj666, imreeyal, uoh-sqak, rstabcde,
# najamjad, nis-yar1) - corrected upward in their second mail; ours is 5. Rule
# 37 wants a truthful count from each side, and they publish theirs at Step-0.
#
# CONFIG FILES ARE NOT BYTE-IDENTICAL AND DO NOT NEED TO BE. Their game.json
# hashes to 9b55a5d9..., ours to c31d3033... (agreed_between now names them; the
# only remaining difference is that we carry board_and_agents.first_mover and
# they do not). Neither side gates on it: in this dialect the constitution IS
# the 14 flat signed terms, and `interop_codec.handshake_from_agreement` mirrors
# our own lock hashes in only when their terms match ours exactly. Verified
# 2026-08-18 - our 14 and theirs are equal as a set and on every value, which is
# their SPAR-N02/N03 gate and ours.

P2P_DIALECT=reference
P2P_ALTERNATE_ROLES=true

# Two doors, one per role they hold. Keyed in THEIR vocabulary: our police is
# their cop, so P2P_OPPONENT_COP_URL is the door we dial while we are the thief.
P2P_OPPONENT_COP_URL=http://62.56.220.143:61224/mcp
P2P_OPPONENT_THIEF_URL=http://62.56.220.143:61223/mcp

# The kit's CORE physics, at their request, and its matching doctrine. Never one
# without the other - tests/unit/test_doctrine_per_physics.py asserts the pair.
P2P_SCENT_MODEL=subtractive_chebyshev_v1
P2P_DOCTRINE=config/doctrine-subtractive.json

# "Each side calls the other's negotiate with a greeting" per sub-game, carrying
# sub_game_number - the push-dialect re-greet, same shape gal-roy1 uses.
P2P_HANDSHAKE_PER_SUB_GAME=true

# CONFIRMED in writing 2026-08-18: "Rules 46/47 we self-declare as thief,
# because they are the endings only the thief can see: a barrier placed on our
# cell, or no legal orthogonal move left." So an enclosure we build is conceded
# rather than played out - the failure turn_engine._enclosed_opponent documents
# against the reference peer cannot happen here, and the squeeze may take the
# last door. Their cop also corroborates a concession against its OWN barrier
# record rather than ours, which is the honest way round.
P2P_CLAIM_ENCLOSURE=true

# CONFIRMED in writing 2026-08-18: their cop attaches capture_claim to EVERY
# turn and they accept and answer ours ("the claim asks one question, am I
# standing on you, and carries no penalty"). Their thief echoes the asked cell
# verbatim in claim_response {claim, caught}. Claiming every turn is therefore
# free here - and the information it used to cost is already public, since a
# served scent field is invertible to an exact cell either way.
P2P_ALWAYS_CLAIM=true

# Six sub-games, opened strictly in sequence, one sequential series.
P2P_SIGNED_NUM_GAMES=6
P2P_MY_PORT=8801

# FRIENDLY: the report goes to OUR OWN INBOX, never the lecturer. Their message
# says the same for their side. The counted contract flips this by DELETING both
# lines, which restores the league address - it is never edited to a new value.
P2P_EMAIL_MODE=send
P2P_EMAIL_RECIPIENT=apexmediamind@gmail.com
