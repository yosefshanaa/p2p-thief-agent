# uoh-ay26 (Aisha Abu Dahesh + Yousef Asadi) - FRIENDLY contract, from their
# pairing document 2026-08-18. Values quoted from that document or verified
# against our code; the one thing they never state is called out below.
#
#   scripts/play.sh uoh-ay26 --role police --games 6
#
# TWO DOORS, BY HOSTNAME:
#     cop    https://cop.uohay26game.com/mcp    (dial when they hold cop)
#     thief  https://theif.uohay26game.com/mcp  (dial when they hold thief)
#
# THE MISSPELLING IS THEIRS AND IT IS DELIBERATE: "The spelling
# theif.uohay26game.com is deliberate and matches the deployed hostname." Do not
# correct it - `thief.` does not resolve. This is also why a `{role}` template
# cannot serve them: substituting our vocabulary yields `thief.`, which is the
# wrong host. Explicit doors, as for vibecode's two ports.
#
# NATURAL ROLE = POLICE. They ask for an explicit schedule rather than assuming
# a convention; sorted(['ahk-yosi','uoh-ay26'])[0] == 'ahk-yosi', so we propose
# and take cop on 1/3/5 and they cop 2/4/6. Confirm in writing before T - they
# make "role schedule matches on both sides" a start condition.
#
# STEP-0, WHICH THEY GATE ON, AND WHICH WE NOW SATISFY:
#   1. negotiation identity carries top-level `git_commit_hash`, 40 lowercase
#      hex. Added 2026-08-18 - we previously sent no commit in the identity at
#      all, which would have been a refusal at negotiation. Both spellings go
#      out now (`git_commit_hash` for them, `github_commit` for amireman).
#   2. the revealed audit begins with a sealed step-0 record carrying
#      {"step": 0, "type": "system_spec"} attached to the records list. We have
#      sealed and cached that since the amireman series
#      (interop_bridge._system_spec_record).
#
# SERIES CONSENSUS: they require the reciprocal `series_consensus` envelope with
# records: [] after all six sub-games, and a consensus_sha over a five-key
# per-row projection. report/consensus.py is a structural match already - same
# ROW_KEYS, same compact separators, technical_loss verbatim, keyed by group id.
# Built for amireman; same lineage.
#
# CAPTURE: police sends capture_claim after EVERY action including STAY and a
# barrier placement, barrier_placed is published independently, and the thief
# answers every public claim cell truthfully with `caught`. So always_claim on.
# Boxed-in is a THIEF-side win_claim {"type":"boxed_in"} on their side, and they
# state coordinate equality is never retroactively converted at audit.

P2P_DIALECT=reference
P2P_ALTERNATE_ROLES=true

P2P_OPPONENT_COP_URL=https://cop.uohay26game.com/mcp
P2P_OPPONENT_THIEF_URL=https://theif.uohay26game.com/mcp

# *** UNSET ON PURPOSE - THEIR DOCUMENT NEVER NAMES A SCENT MODEL. ***
# It is the one hard refusal on our side and on every reference peer we have
# played, so it must be agreed in writing before T rather than defaulted into.
# Uncomment the pair once they answer; the model and the doctrine are ONE
# decision in two variables (tests/unit/test_doctrine_per_physics.py).
#   book_v1                   ea7225f5d71989add99a0057287342b7c5b86ab4efffd1608da25d0e368c0a28
#   registered_v3             0761ca169ee93a11cb19e6e28251074ab7223bdb157ec5123138d87aad651f6f
#   subtractive_chebyshev_v1  81ebee59640e80eae8ca9ee5f86abd26e7edf5cdbb27d15925cb6ee45ca6ddf4
# P2P_SCENT_MODEL=subtractive_chebyshev_v1
# P2P_DOCTRINE=config/doctrine-subtractive.json

P2P_HANDSHAKE_PER_SUB_GAME=true
P2P_SERIES_CONSENSUS=true
P2P_ALWAYS_CLAIM=true

# Their thief self-declares boxed_in via win_claim, so an enclosure we build is
# conceded rather than played out. Confirm in the friendly before trusting it.
P2P_CLAIM_ENCLOSURE=true

P2P_SIGNED_NUM_GAMES=6
P2P_MY_PORT=8801

# They want a unique series label such as G010 - agree it in writing, then set
# it here so both sides derive the same game_id.
# P2P_GAME_ID=

# FRIENDLY: our own inbox, never the lecturer. Their auto-report sender is
# aishadahesh11@gmail.com. The counted contract DELETES both lines.
P2P_EMAIL_MODE=send
P2P_EMAIL_RECIPIENT=apexmediamind@gmail.com
