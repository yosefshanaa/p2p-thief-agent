# DEMO / warm-up contract vs. team `saedshki` - identical wire terms to
# saedshki.env, differing ONLY in where the report goes.
#
#   scripts/play.sh saedshki-demo https://their-tunnel.example/mcp --role thief --games 6
#
# saedshki.env keeps P2P_EMAIL_MODE=draft so an accidental warm-up can never
# reach the lecturer. This file instead SENDS, to us. That is deliberate: a
# demo whose report lands in our own inbox proves the whole Gmail path works
# end to end - token, scopes, attachment, formatting - before the counted match
# depends on it, without the lecturer receiving a warm-up.
#
# NEVER add --counted to a run that loads this file: the counted report must go
# to the lecturer, which means saedshki.env with its draft line removed.

# -- wire contract: identical to saedshki.env (their reply of 2026-08-16) -----
P2P_DIALECT=reference
P2P_ALTERNATE_ROLES=true
P2P_HANDSHAKE_PER_SUB_GAME=true
# Confirmed (a): their thief self-reports enclosure, so our police must not
# also claim it - see saedshki.env for the full reasoning.
P2P_CLAIM_ENCLOSURE=false
P2P_SCENT_MODEL=book_v1
P2P_DOCTRINE=config/doctrine.json
P2P_SERIES_CONSENSUS=true

# -- reporting: the only difference from saedshki.env ------------------------
# Send for real, but to us, not to rmisegal+uoh26finalgame@gmail.com.
P2P_EMAIL_MODE=send
P2P_EMAIL_RECIPIENT=ahmadkaiss920@gmail.com
