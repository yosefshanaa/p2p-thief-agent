# Team s82kma9e (Mohammed + Muhammad) - answers received 2026-08-17.
# FRIENDLY contract. Do not add --counted against this file until the scent
# question at the bottom is settled.
#
# MUST be launched with their config dir, or the game_uid will not match:
#
#   scripts/play.sh s82kma9e https://their-tunnel/mcp \
#       --role police --config-dir config/opponents/s82kma9e/police
#
# config/opponents/s82kma9e/{police,thief}/ differs from the committed config in
# exactly two places, both of which they require and neither of which may leak
# into another team's match:
#   game.json  world.map_area  "New York" -> "Haifa"   (their `setting` term)
#   game.toml  group_name/id   "ahk-yosi" -> "sparring-ahk-yosi"
# With those, our interop_terms digest is
#   ad9e1bfd724e9debcde523833381cb7982a5d619d693d3738b59e0da61f4d81a
# which is theirs exactly, and the derived ids are
#   game_id  sparring-ahk-yosi-vs-sparring-s82kma9e
#   game_uid 9b903d4c-68c9-298c-8052-32aa7970e96e
# The uid is derived from the terms and BOTH group slugs and is never
# overridable (runtime.py) - which is why the slug had to move in config.

# -- wire contract ------------------------------------------------------------
# They say "reference-v3 from the copthief-league-protocol kit". Our `reference`
# dialect was built against the peer we had in hand, not against a thing calling
# itself v3, so PROBE BEFORE PLAYING and trust the probe over this line:
#   PYTHONPATH=src .venv/bin/p2p-pursuit smoke https://their-tunnel/mcp
P2P_DIALECT=reference

# Confirmed by them: thief in 1/3/5, police in 2/4/6 if they open as thief.
P2P_ALTERNATE_ROLES=true

# Confirmed by them: new handshake per sub-game, one process / tunnel / game_id
# / game_uid for the whole series. This is the pairing that killed a series at
# sub-game 2 when we guessed it wrong (RUNBOOK); it is switched on deliberately.
P2P_HANDSHAKE_PER_SUB_GAME=true

# -- enclosure (book 3.4) -----------------------------------------------------
# Their thief announces its own capture; their cop must not. So our cop stays
# quiet, which is this switch's `false`. Exactly one side may report it.
#
# Their declaration rides as `claim_response: {"claim":[r,c],"caught":true}` on
# an ordinary receive_turn - NOT `capture_claim`, which in their vocabulary is
# the cop's question. Checked 2026-08-17: interop_bridge.py already reads
# claim_response and routes `caught` to unsealed_events.note_capture_confirmed,
# and already emits our own thief's 46/47 concession in that exact shape. No
# change needed - the earlier worry was unfounded.
P2P_CLAIM_ENCLOSURE=false

# They did not say their cop's capture claim is unsuppressable, so our default
# gating stands. If they later say it is protocol-level every turn, flip this or
# we silently forfeit captures we earned.
P2P_ALWAYS_CLAIM=false

# -- scent physics ------------------------------------------------------------
# We emit book_v1; they emit subtractive_chebyshev_v1. NO LOCK is declared for
# this friendly - their own offer, and both sides agreed. Do not declare a
# multiplicative lock against them; they asked explicitly.
#
# Their kernel arrived and their two worked examples reproduce exactly from the
# algorithm they stated (verified 2026-08-17): flat Chebyshev rings 0.9/0.6/0.3,
# max-merged into the existing field, then a flat -0.1, clamped at 0, rounded to
# 3dp. Their freshest centre reads 0.8.
#
# Why the friendly runs honestly anyway: each side transmits its own grid and
# consumes the other's (`smell_grid` -> grid_to_scent), so neither recomputes
# the other's physics; and belief.scent_update divides by the field's own peak,
# so their magnitude shift cancels. What does NOT cancel is the shape - their
# rings are flat where our figure-4 kernel is graded, so after normalisation
# their ring-1 reads 0.625 against our 0.765. Their centre is still uniquely
# maximal, so our argmax still lands on their true cell; we lose shading around
# it, not the peak. Their trail is also shorter-lived (linear -0.1 zeroes a
# centre in 8 turns; ours decays multiplicatively for ~20), so our staleness
# priors read their field as fresher than our doctrine assumes.
#
# For a COUNTED match they would prefer the model implemented and locked, and it
# is now fully specified - kernel plus two golden fields to test against. That
# is a domain/scent.py change (a third entry in MODELS), not a config change.
P2P_SCENT_MODEL=book_v1
P2P_DOCTRINE=config/doctrine.json

# -- series consensus ---------------------------------------------------------
# They described no end-of-series digest exchange, so this stays off. Switching
# it on unilaterally rides an audit package with no records and files a
# technical loss over a cleanly played series.
P2P_SERIES_CONSENSUS=false

# -- agreed game_id label -----------------------------------------------------
# They named it. With the sparring slug in the config dir our own derivation
# produces this same string, so this line is belt-and-braces rather than a
# correction - but it is set explicitly because a label present on one side only
# is a guaranteed digest mismatch.
# CHANGE THIS for any later run against them: a settled series is immutable, so
# reusing a label hashes a new series under a settled one's name.
P2P_GAME_ID=sparring-ahk-yosi-vs-sparring-s82kma9e

# -- EMAIL: this is a FRIENDLY ------------------------------------------------
# Ahmad wants his own copy of the friendly's report, so this is the TEMPLATE's
# "send it to yourself instead" path: mode=send with the recipient pointed away
# from the lecturer. Both lines are load-bearing - dropping the recipient line
# while leaving mode=send files this friendly against the lecturer and it reads
# as THE counted encounter, of which the book allows exactly one per pair.
# play.sh's guard catches exactly that combination, but do not rely on it.
#
# This does not break what we told s82kma9e ("no email"): what we agreed was no
# counted report filed with the course, and none is filed. This is a private
# copy of our own artifact to our own inbox.
P2P_EMAIL_MODE=send
P2P_EMAIL_RECIPIENT=ahmadkaiss920@gmail.com

# -- constitution -------------------------------------------------------------
# They have not said whether they accept ours (sha256 3835f6a1...). Their kit
# compares agreed terms for exact equality and refuses on mismatch, so if they
# send their own, build config/opponents/s82kma9e/{police,thief}/ and pass
#   --config-dir config/opponents/s82kma9e/police
# rather than editing the committed constitution.
