# Negotiated contract vs. team `amireman` - see docs/interop_amireman.md.
# Source: their "P2P Cop-Thief Match Interoperability Guide" + the schema 1.2
# agreement JSON naming ["amireman", "ahk-yosi"], both received 2026-08-14.
#
#   fish:  for l in (grep -v '^#' config/opponents/amireman.env); set -x (string split -m1 = $l); end
#   bash:  set -a; . config/opponents/amireman.env; set +a

# -- wire contract (their guide) ---------------------------------------------
# Reference family again: their four tools are negotiate / receive_turn /
# submit_audit / receive_control, push model, handlers enqueue-and-return
# {"ok": true} (their sec. 7). Roles alternate - natural role on sub-games
# 1/3/5, opposite on 2/4/6 (their sec. 6) - and they renegotiate before every
# sub-game (their sec. 3, "a fresh handshake per sub-game").
P2P_DIALECT=reference
P2P_ALTERNATE_ROLES=true
P2P_HANDSHAKE_PER_SUB_GAME=true

# Their sec. 5 conditions (B) barrier-on-thief and (C) thief-trapped are both
# evaluated by THE THIEF against its own true cell, and answered in
# claim_response.caught. So enclosure is thief-announced and our cop must not
# also claim it - two mechanisms reporting one event desynchronises the series.
# Third reference-family opponent in a row to want it this way.
P2P_CLAIM_ENCLOSURE=false

# -- their sec. 5: the claim is protocol-level and unsuppressable ------------
# "The Cop always declares a capture-claim for its own post-move cell - on every
# Cop turn, including STAY and barrier turns - with no gating. It is set by the
# protocol/runtime layer, not chosen by strategy, and cannot be suppressed."
#
# Ours IS chosen by strategy: police_brain.should_claim() gates on
# claim_threshold=0.15 because in our own dialect a claim leaks our cell. Under
# their rules a gated claim is strictly worse than useless - their thief only
# tests condition (A) against a claim it actually receives, so a turn where we
# step onto their cell WITHOUT claiming is a capture we earned and do not get.
# This flag makes the claim unconditional, exactly as their sec. 5 demands.
#
# The trade is symmetric and in our favour: their cop must declare its own cell
# every turn too, and turn_engine._answer_claim already collapses our thief's
# belief to a delta at a claimed cell - so our thief tracks their cop perfectly
# for free, all six sub-games. That is the half we lost 0-6 to orcai-mj.
# MEASURED 2026-08-19, and it reverses the guess above. Claiming on every
# police turn hands the thief our exact cell every turn: `turn_engine._answer_claim`
# collapses the answering side's belief to a delta on the claimed cell, which is
# the claimant's own position. Against `learn.opponents.Evader` over 100 hold-out
# seeds, police capture rate:
#
#     book_v1      always_claim=false 35%   ->   always_claim=true  0%
#     subtractive  always_claim=false 21%   ->   always_claim=true 23%
#
# Under book_v1 the thief otherwise has only a one-turn-old fix, so the claim is
# the whole leak - and gal-roy1, played on book_v1 with this set, converted 0 of
# 3. Under subtractive it costs nothing because the thief can invert our served
# field anyway. The forfeited-capture risk this was hedging against is closed by
# v6: `police_brain.should_claim` already claims whenever the tracker puts the
# thief on the cell we just took, which is exact under subtractive and a spread
# under book_v1. Every match we played WITHOUT this converted 3 of 3.
P2P_ALWAYS_CLAIM=false

# -- their sec. 15: --games must NOT move the signed num_games ---------------
# "--games N sets how many sub-games the run loops. It does NOT change the
# signed num_games, which stays 6." Ours signed whatever --games said, so a
# 2-game smoke run would have signed num_games=2 against their 6 and been
# refused as a terms mismatch - on the very compatibility test their sec. 19
# gates the official match behind. Pin the signed value to the constitution.
P2P_SIGNED_NUM_GAMES=6

# -- their sec. 10.3 + 11: the explicit series-consensus exchange ------------
# After the last sub-game both sides hash {game_id, game_uid, sub_games} - five
# group-keyed fields per row, compact separators - and trade the digest in a
# submit_audit envelope carrying result_claim="series_consensus" and records=[].
# We had none of this: "consensus" appeared nowhere in src/ before 2026-08-14.
# OFF for every other opponent, because the envelope rides on the same tool as
# the per-sub-game audits: a peer that does not expect it there reads an audit
# package with no records and files a technical loss over a clean series. That
# is exactly what our own on_submit_audit did until it learned to intercept it.
P2P_SERIES_CONSENSUS=true

# -- scent physics ------------------------------------------------------------
# Their Appendix E is book_v1 exactly: the same 5x5 radial kernel by (|dr|,|dc|)
# with 0.90/0.62/0.42/0.20/0.14/0.04, and tau_next = min(0.9, max(0, (1-rho)*tau
# + delta)) with rho=0.1. Their four signed scent terms equal ours. They do not
# state a serve order (pre- vs post-emission), and their sec. "What must match"
# says only the four terms and the {"r,c": intensity} wire shape must agree -
# how each side uses received scent is explicitly local. So book_v1 + the
# doctrine tuned for it. Confirm serve order before the counted match anyway;
# it is question 3 in the reply.
P2P_SCENT_MODEL=book_v1
# The orcai-mj vector: committed doctrine + the 11 re-searched thief keys
# (corner_penalty 0.24 -> 1.31, stay_penalty 0.05 -> 1.23, hold-out survival
# 81% -> 89%), police keys byte-identical to config/doctrine.json. Same physics,
# same 7x7, same 35 steps - it transfers. Their cage is not orcai-mj's, so this
# is a starting vector, not a fitted one.
P2P_DOCTRINE=config/doctrine-orcai-mj.json

# -- terms: NO env override needed -------------------------------------------
# All 14 of their Appendix A terms are produced exactly - values AND JSON types -
# by config/opponents/amireman/<role>/game.json below. Verified 2026-08-14:
#   key set equal, 14/14 OK, including setting="Haifa" (committed default is
#   "New York", which is why the per-opponent config dir is mandatory here).
# Derived under those terms, both sides must land on:
#   game_id  = ahk-yosi-vs-amireman        (unless overridden to an agreed label)
#   game_uid = ab6022d2-716a-f5b3-556e-43f70ffa7b09
# Do NOT set P2P_MAP_AREA to do this instead - see the config-dir note below.

# -- FRIENDLY AHK-DEMO1: send, but to OURSELVES ------------------------------
# 2026-08-14 operator decision: the demo result should actually be mailed, so we
# exercise the real reporting path end to end before G011 - but to our own
# address, never the lecturer.
#
# These TWO lines are a pair and must never be separated. The committed role
# config carries recipient = rmisegal+uoh26finalgame@gmail.com and mode =
# "send", so P2P_EMAIL_MODE=send ALONE would mail the lecturer a friendly
# result - and the book allows exactly one counted encounter per opponent,
# sealed the moment it is filed. A friendly landing there could be read as THE
# amireman match and burn G011 before it is played.
#
# Verified 2026-08-14 by loading the config with both set: recipient resolves to
# apexmediamind@gmail.com, mode to "send". Re-verify after any edit here.
P2P_EMAIL_MODE=send
P2P_EMAIL_RECIPIENT=apexmediamind@gmail.com

# -- superseded: the draft lock this replaces --------------------------------
# Kept as the record of why `draft` was the default for every prior friendly.
# For G011 (counted), DELETE the two lines above so the committed recipient and
# mode apply, and the lecturer is mailed exactly once.
# Both role configs ship [email] mode = "send". A friendly report filed against
# an opponent risks being read as THE counted encounter, and the book allows
# exactly one per pair, sealed once filed. So a friendly must be INCAPABLE of
# sending, not merely unlikely to. Remove this line - and only this line - at
# the moment the counted match launches. amireman is a DIFFERENT opponent from
# orcai-mj, so this is the line whose removal is finally legitimate again.
#
# COMMENTED OUT 2026-08-14, and the ordering is the whole point: this file is
# sourced line by line, so a live `P2P_EMAIL_MODE=draft` *below* the send block
# silently wins and the demo would file nothing. Left visible rather than
# deleted because it is the line to restore for any future friendly that should
# stay unsendable.
# P2P_EMAIL_MODE=draft

# -- constitution: PER-OPPONENT CONFIG DIR, not the committed one ------------
# Two reasons this cannot be done with env overrides on the committed file:
#   1. agreed_between names ONE opponent (["amireman", "ahk-yosi"], their
#      spelling and their order), and there is no NEGOTIABLE_TERM_VARS entry
#      for a top-level key.
#   2. setting/map_area must be "Haifa" for them and stays "New York" for
#      everyone else; editing config/<role>/game.json would ride into the next
#      opponent's handshake.
# So BOTH peers must be launched with:
#
#   --config-dir config/opponents/amireman/police     (police, port 8802)
#   --config-dir config/opponents/amireman/thief      (thief,  port 8801)
#
# Committed constitution stays 0061d8f8...dc088 with "opponent-team".
# This file hashes to 429f456154c3e1985b3197d32821efbc718eeaedb9ed5e74950ef1ca69877c5e.

# -- 2026-08-14 agreed demo: AHK-DEMO1 ---------------------------------------
# They declined the sec. 15 two-game smoke and asked for a FULL six-game
# NON-COUNTED demo instead, under a mutually agreed label. Their sec. 3 allows
# the override and warns that game_id is part of the consensus hash - so this
# string must be byte-identical on both sides or a cleanly-played series fails
# at the final digest, which is the one thing the demo exists to prove.
# The UID is NOT overridden and stays ab6022d2-716a-f5b3-556e-43f70ffa7b09.
# Unset this line for the counted match, which they have named G011.
# AHK-DEMO2 (2026-08-14): rerun after they fixed the 2x-negotiation defect
# DEMO1 exposed - they negotiated every sub-game exactly twice (2/2/2 across
# indices 1/2/3) and so ran at half our rate, reaching their 3rd as we finished
# our 6th. peer_consensus_sha came back null. Their new runtime SHA for this
# rerun: bb0352613990d70c334d71262bd76909e9243f84.
# The label MUST change per run: game_id is a top-level key of the consensus
# object, and their sec. 13 makes a completed series immutable - reusing
# AHK-DEMO1 would hash a new series under a settled one's name.
# AHK-DEMO4 (2026-08-14): the rerun after DEMO3, in which their audit of us
# failed 0-of-N on every sub-game. Cause was ours and is fixed - our submit_audit
# envelope named no sub-game, so it could only be filed by arrival time, and our
# peer waits 20 s for their package while theirs does not: our sub-game n reveal
# consistently landed in their n+1 bucket. See docs/interop_amireman.md sec. 4d.
# The label MUST change per run: game_id is a top-level key of the consensus
# object, and their sec. 13 makes a completed series immutable - reusing
# AHK-DEMO1/2/3 would hash a new series under a settled one's name.
P2P_GAME_ID=AHK-DEMO4
# Demo is uncounted: launch WITHOUT --counted, and P2P_EMAIL_MODE stays draft
# below so the lecturer cannot be mailed. Six sub-games, full alternation.

# -- settled with them 2026-08-14 --------------------------------------------
# Timeout: 180 s per turn. They confirmed the 30/60 in their agreement JSON are
# local network/watchdog config, NOT part of the 14 signed terms - so our
# committed turn_timeout_seconds=180 stands and no override is needed.
# Scent serve order: they accept our pre-emission serve (freshest cell 0.81) as
# a local implementation detail; the four signed scent terms and the
# {"r,c": intensity} wire shape are unchanged. P2P_SCENT_MODEL=book_v1 stands.

# -- match day ---------------------------------------------------------------
# Their sec. 17: amireman starts the official series as THIEF, so WE open as
# POLICE. With alternation that puts us police on 1/3/5 and thief on 2/4/6.
# Their mcp_servers map may point both roles at one URL, so expect a single
# endpoint unless they say otherwise (orcai-mj ran two).
# P2P_OPPONENT_URL=https://THEIR-TUNNEL/mcp
