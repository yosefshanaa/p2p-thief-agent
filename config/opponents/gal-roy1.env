# gal-roy1 (Gal + Roy) - FRIENDLY contract, from their written reply 2026-08-17.
#
#   scripts/play.sh gal-roy1 https://their-tunnel/mcp --role police --games 6
#
# We take POLICE as the natural role on purpose: their alternation rule is
# "sorted group_ids, first-sorted cops the odd sub-games", and ahk-yosi sorts
# before gal-roy1, so we cop 1/3/5 and they cop 2/4/6. Launching --role thief
# would put both peers on the same role in every sub-game.
#
# Repos (private, shared with the lecturer - we could NOT read their code):
#   cop   https://github.com/galbb12/orch-models-final-cop
#   thief https://github.com/galbb12/orch-models-final-thief
# Agent email for the submission form: galbb12@gmail.com
#
# Two lines below are STILL UNCONFIRMED by them - see the block comments.
# Both are settled by watching the friendly, which is what the friendly is for.

P2P_DIALECT=reference
P2P_ALTERNATE_ROLES=true

# They handshake once per series but re-greet each sub-game with the
# sub_game_number in the opener, which is this flag's push-dialect behaviour.
P2P_HANDSHAKE_PER_SUB_GAME=true

# Their cop claims rule 46 (a barrier landing on the thief's cell) and their
# thief concedes it unprompted. Rule 47 (boxed in, no legal move) they do NOT
# announce unprompted, so our cop has to claim it or we lose a won corner to
# "survival" 20 turns later - the exact failure turn_engine._enclosed_opponent
# documents against the reference peer.
P2P_CLAIM_ENCLOSURE=true

# UNCONFIRMED. Their design is claim-and-response ("the cop places the barrier
# and the thief responds to the claim"), and under a contract like that our
# default gating silently forfeits captures we earned - amireman's series cost
# us exactly that. Claiming every police turn is the safe side of the asymmetry;
# if their thief errors on an unfounded claim instead of answering caught:false,
# the friendly will show it on turn 1 and this goes back to false.
P2P_ALWAYS_CLAIM=true

# UNCONFIRMED. They did not answer whether their report carries a mutual
# signature / end-of-series consensus digest. Left OFF because it rides on
# submit_audit: switching it on against a peer that does not expect it there
# makes them read an audit package with no records and file a technical loss
# over a cleanly played series. Turn it on only if they say yes in writing.
P2P_SERIES_CONSENSUS=false

# A short compatibility run must still sign the agreed six.
P2P_SIGNED_NUM_GAMES=6

# Their proposal was book_v1; they also said they implement all three and will
# adopt our model document byte-for-byte. We asked for subtractive: it is our
# best measured cell (14.94 vs 13.19 pts/sub-game), it is the physics of the one
# cross-team counted series we have audited clean in both directions, and under
# it the top scent cell IS the thief's current cell (0.8 >= the 0.7 floor in
# turn_engine.ENCLOSURE_SCENT_MIN), which is what makes a rule-47 claim name the
# right cell at all. Under book_v1 the freshest cell reads 0.558 and the 0.81 is
# the cell the thief has already left.
# IF THEY REFUSE, both of these lines move back together:
#     P2P_SCENT_MODEL=book_v1
#     P2P_DOCTRINE=config/doctrine.json
P2P_SCENT_MODEL=subtractive_chebyshev_v1
P2P_DOCTRINE=config/doctrine-subtractive.json

# The tunnel we opened is on 8801 (the thief port) and we are playing police, so
# the port is pinned rather than taken from config/police/game.toml - otherwise
# the peer serves 8802 and the URL they already have goes nowhere.
P2P_MY_PORT=8801

# FRIENDLY: nothing reaches the lecturer.
P2P_EMAIL_MODE=draft

# The consensus label must differ from the counted one - a settled series is
# immutable, so the derived "ahk-yosi-vs-gal-roy1" is reserved for the counted
# match (they agreed that label). Delete this line for the counted run.
P2P_GAME_ID=friendly-ahk-yosi-vs-gal-roy1
