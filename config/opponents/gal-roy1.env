# gal-roy1 (Gal + Roy) - FRIENDLY contract, from their written reply 2026-08-17.
#
#   scripts/play.sh gal-roy1 'http://galbb.freeddns.org:6000/{role}/mcp' \
#       --role police --games 6
#
# MIND THE URL. They gave us http://galbb.freeddns.org:6000/mcp; nothing is
# mounted there (404 on GET and on the MCP POST). They serve one agent per role
# on that port - /cop/mcp and /thief/mcp, both 406 to a plain GET, which is
# FastMCP asking for the event-stream Accept header, and both probe as
# dialect=reference with 11 tools. Because roles alternate, the agent we must
# push to changes every sub-game, so the URL is passed as a `{role}` template
# and re-targeted at each boundary (shared/config.opponent_url_for,
# peer/series_protocol.retarget_link). `{role}` is substituted in THEIR
# vocabulary: our police is their cop.
#
# We take POLICE as the natural role on purpose: their alternation rule is
# "sorted group_ids, first-sorted cops the odd sub-games", and ahk-yosi sorts
# before gal-roy1, so we cop 1/3/5 and they cop 2/4/6. Launching --role thief
# would put both peers on the same role in every sub-game.
#
# Repos (private, shared with the lecturer - we could NOT read their code):
#   cop   https://github.com/galbb12/orch-models-final-cop
#   thief https://github.com/galbb12/orch-models-final-thief
# Agent email for the submission form: galbb12@gmail.com
#
# Two lines below are STILL UNCONFIRMED by them - see the block comments.
# Both are settled by watching the friendly, which is what the friendly is for.

P2P_DIALECT=reference
P2P_ALTERNATE_ROLES=true

# They handshake once per series but re-greet each sub-game with the
# sub_game_number in the opener, which is this flag's push-dialect behaviour.
P2P_HANDSHAKE_PER_SUB_GAME=true

# Their cop claims rule 46 (a barrier landing on the thief's cell) and their
# thief concedes it unprompted. Rule 47 (boxed in, no legal move) they do NOT
# announce unprompted, so our cop has to claim it or we lose a won corner to
# "survival" 20 turns later - the exact failure turn_engine._enclosed_opponent
# documents against the reference peer.
P2P_CLAIM_ENCLOSURE=true

# UNCONFIRMED. Their design is claim-and-response ("the cop places the barrier
# and the thief responds to the claim"), and under a contract like that our
# default gating silently forfeits captures we earned - amireman's series cost
# us exactly that. Claiming every police turn is the safe side of the asymmetry;
# if their thief errors on an unfounded claim instead of answering caught:false,
# the friendly will show it on turn 1 and this goes back to false.
P2P_ALWAYS_CLAIM=true

# UNCONFIRMED. They did not answer whether their report carries a mutual
# signature / end-of-series consensus digest. Left OFF because it rides on
# submit_audit: switching it on against a peer that does not expect it there
# makes them read an audit package with no records and file a technical loss
# over a cleanly played series. Turn it on only if they say yes in writing.
P2P_SERIES_CONSENSUS=false

# A short compatibility run must still sign the agreed six.
P2P_SIGNED_NUM_GAMES=6

# Their proposal was book_v1; they also said they implement all three and will
# adopt our model document byte-for-byte. We played the friendly on subtractive
# and it lost 30-90 (6 sub-games, every one audited Verified OK), so this is now
# book_v1 - the friendly falsified the reason we chose subtractive in the first
# place:
#
#   Under `deposit_then_decay` the field WE transmit has our own cell at 0.8 and
#   every other cell at <= 0.7, so the maximum of the map we hand them IS our
#   thief's position. Their cop read it and dropped a barrier straight onto that
#   cell - rule 46, instant capture - in ALL THREE sub-games we played as thief
#   (2026-08-17: barrier onto (5,6), (0,5), (1,0)). The 14.94 pts/sub-game that
#   argued for subtractive was measured against sparring clones that never
#   exploit the leak, so it did not price this in.
#
#   book_v1 serves PRE-emission, which is exactly the protection: the maximum of
#   the field we transmit is the cell the thief has already LEFT, one step stale.
#   Its lock document says so in as many words ("serving": "each step serves the
#   field BEFORE that step's emission"), so agreeing the hash also pins the order
#   and the ambiguity that bit us on the subtractive negotiation cannot recur.
#
# The other half of that friendly is not fixed by this and is still open: as
# police we captured NOTHING in three sub-games, their thief surviving all 35
# steps each time.
# TO GO BACK, both of these lines move together - never one alone:
#     P2P_SCENT_MODEL=subtractive_chebyshev_v1
#     P2P_DOCTRINE=config/doctrine-subtractive.json
P2P_SCENT_MODEL=book_v1
P2P_DOCTRINE=config/doctrine.json

# The tunnel we opened is on 8801 (the thief port) and we are playing police, so
# the port is pinned rather than taken from config/police/game.toml - otherwise
# the peer serves 8802 and the URL they already have goes nowhere.
P2P_MY_PORT=8801

# COUNTED, 2026-08-17. Both overrides are OFF so the committed role config
# applies: mode=send to rmisegal+uoh26finalgame@gmail.com. This is the line that
# makes it the one counted encounter the book allows for this pair, sealed the
# moment both reports are filed. To go back to a friendly, restore:
#     P2P_EMAIL_MODE=send
#     P2P_EMAIL_RECIPIENT=apexmediamind@gmail.com
# (Friendlies played on this contract: friendly-/friendly2-/friendly3- labels,
#  2026-08-17, lost 30-90 on subtractive and 40-60 on book_v1.)

# No label override: the derived "ahk-yosi-vs-gal-roy1" is what both sides
# agreed for the counted match, and a settled series is immutable, so the three
# friendly labels can never be reused.
